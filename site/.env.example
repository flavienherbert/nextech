# Copier ce fichier en .env.local et le remplir. Ne jamais enregistrer le fichier rempli dans le dépôt.
# Pour un simple essai local, rien à remplir : lancer « npm run demo ».

# ── Site ──────────────────────────────────────────────────────────────
# Adresse publique du site, sans barre finale. Sert aux liens des e-mails et aux retours de paiement.
SITE_URL=http://localhost:3000

# ── Stripe (voir STRIPE.md) ───────────────────────────────────────────
# Clé de test rk_test_… ou sk_test_…  Une clé réelle est refusée tant que VENTES_REELLES
# n'est pas « oui » et que les mentions légales ci-dessous sont incomplètes.
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_…).
STRIPE_WEBHOOK_SECRET=
# À laisser vide. Ne sert qu'au simulateur local (npm run demo).
STRIPE_API_HOST=
# Mettre « oui » uniquement le jour de l'ouverture commerciale.
VENTES_REELLES=

# ── Espace administrateur ─────────────────────────────────────────────
# Mot de passe de /admin : 12 caractères minimum, unique, non réutilisé ailleurs.
ADMIN_PASSWORD=
# Chaîne aléatoire de 32 caractères minimum. Signe la session et les autorisations d'envoi de fichiers.
# La changer déconnecte immédiatement toutes les sessions.
SESSION_SECRET=
# Adresse qui reçoit les notifications de commande.
ADMIN_EMAIL=

# ── Stockage ──────────────────────────────────────────────────────────
# Sans les variables S3, tout est rangé dans ce dossier (disque local).
DATA_DIR=./data
# Stockage de fichiers compatible S3 (Supabase Storage, Cloudflare R2, Scaleway, AWS…). Dès que le bucket
# et les deux clés sont renseignés, le site l'utilise à la place du disque pour les photos, vidéos et PDF.
# Procédure complète pour Supabase : SUPABASE.md.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Supabase : https://<réf-du-projet>.storage.supabase.co/storage/v1/s3
# (Cloudflare R2, resté une option jamais activée : https://<identifiant-de-compte>.r2.cloudflarestorage.com)
S3_ENDPOINT=
# Supabase : la région affichée sur la page « S3 Connection » (ex. eu-central-1). « auto » pour R2.
S3_REGION=auto
# « oui » pour Supabase (adresses de type endpoint/bucket/clé).
S3_PATH_STYLE=
# Origine du stockage vue par le navigateur (même valeur que S3_ENDPOINT, sans chemin),
# pour autoriser l'envoi direct des fichiers. À définir avant la compilation.
S3_PUBLIC_ORIGIN=

# Base de données PostgreSQL pour les documents (commandes, compteur de factures, événements, e-mails).
# Avec Supabase : « Connect » > « Transaction pooler » > copier l'URI (voir SUPABASE.md). SECRET.
# Quand elle est définie, les documents JSON vont dans la base et seuls les fichiers vont dans le stockage S3.
# Sans elle, tout reste dans un seul pilote, SAUF avec Supabase Storage, refusé sans base (garde-fou).
DATABASE_URL=
# Facultatif : certificat racine du serveur (contenu PEM) pour vérifier son identité.
DATABASE_CA=
# Connexions simultanées maximum par instance du site (3 par défaut).
DATABASE_POOL_MAX=
# Taille maximale d'une vidéo livrée, en Mo. 50 par défaut : plafond de l'offre gratuite de Supabase.
LIVRABLE_MAX_MO=
# NE PAS UTILISER avec Supabase tant que « npm run verifier:stockage » n'a pas démontré les écritures conditionnelles.
DOCUMENTS_SUR_STOCKAGE=

# ── E-mails ───────────────────────────────────────────────────────────
# Sans clé, les e-mails sont rédigés et archivés dans /admin/courriels, mais pas envoyés.
# Expéditeur, sur un domaine vérifié chez le service. Exemple : Studio Accroche <commandes@mondomaine.fr>
MAIL_FROM=
# Renseigner l'une des deux clés (Brevo est prioritaire si les deux sont présentes).
BREVO_API_KEY=
RESEND_API_KEY=

# ── Mentions légales (obligatoires avant toute vente réelle et toute facture) ──
NEXT_PUBLIC_LEGAL_NAME=
# 14 chiffres.
NEXT_PUBLIC_LEGAL_SIRET=
NEXT_PUBLIC_LEGAL_ADDRESS=
# Adresse de contact dédiée, jamais l'adresse personnelle.
NEXT_PUBLIC_CONTACT_EMAIL=
# Nom et adresse de l'hébergeur du site.
NEXT_PUBLIC_LEGAL_HEBERGEUR=
# Nom et site du médiateur de la consommation choisi.
NEXT_PUBLIC_LEGAL_MEDIATEUR=

# ——— Préproduction privée ———
# Si cette variable est définie, tout le site demande ce mot de passe (identifiant libre).
# À retirer le jour de l'ouverture au public.
PREPROD_PASSWORD=
