# Copier ce fichier en .env.local et le remplir. Ne jamais l'enregistrer dans le dépôt une fois rempli.
# Pour un simple essai local, rien à remplir : lancer « npm run demo ».

# ── Site ──────────────────────────────────────────────────────────────
# Adresse publique du site, sans barre finale. Sert aux liens des e-mails et aux retours de paiement.
SITE_URL=http://localhost:3000
# Dossier où sont rangés commandes, fichiers et e-mails (doit être persistant chez l'hébergeur).
DATA_DIR=./data

# ── Stripe ────────────────────────────────────────────────────────────
# Clé secrète : sk_test_… en préproduction. Une clé sk_live_… est refusée tant que
# VENTES_REELLES n'est pas « oui » et que les mentions légales ci-dessous sont incomplètes.
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_…), fourni par Stripe pour l'adresse <SITE_URL>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# À laisser vide. Ne sert qu'au simulateur local (npm run demo).
STRIPE_API_HOST=
# Mettre « oui » uniquement le jour de l'ouverture commerciale.
VENTES_REELLES=

# ── Espace administrateur ─────────────────────────────────────────────
# Mot de passe de /admin : 10 caractères minimum.
ADMIN_PASSWORD=
# Chaîne aléatoire de 32 caractères minimum, qui signe la session.
SESSION_SECRET=
# Adresse qui reçoit les notifications de commande.
ADMIN_EMAIL=

# ── E-mails ───────────────────────────────────────────────────────────
# Sans ces deux valeurs, les e-mails sont rédigés et archivés dans /admin/courriels, mais pas envoyés.
RESEND_API_KEY=
# Expéditeur, sur un domaine vérifié chez le service d'envoi. Exemple : Studio Accroche <commandes@mondomaine.fr>
MAIL_FROM=

# ── Mentions légales (obligatoires avant toute vente réelle) ──────────
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_SIRET=
NEXT_PUBLIC_LEGAL_ADDRESS=
# Adresse de contact dédiée, jamais l'adresse personnelle.
NEXT_PUBLIC_CONTACT_EMAIL=
# Nom et adresse de l'hébergeur du site.
NEXT_PUBLIC_LEGAL_HEBERGEUR=
# Nom et site du médiateur de la consommation choisi.
NEXT_PUBLIC_LEGAL_MEDIATEUR=
