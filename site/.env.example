# Copier ce fichier en .env.local et le remplir. Ne jamais enregistrer le fichier rempli dans le dépôt.
# Pour un simple essai local, rien à remplir : lancer « npm run demo ».

# ── Site ──────────────────────────────────────────────────────────────
# Adresse publique du site, sans barre finale. Sert aux liens des e-mails et aux retours de paiement.
SITE_URL=http://localhost:3000

# ── Stripe (voir STRIPE.md) ───────────────────────────────────────────
# Clé de test rk_test_… ou sk_test_…  Une clé réelle est refusée tant que VENTES_REELLES
# n'est pas « oui » et que les mentions légales ci-dessous sont incomplètes.
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_…).
STRIPE_WEBHOOK_SECRET=
# À laisser vide. Ne sert qu'au simulateur local (npm run demo).
STRIPE_API_HOST=
# Mettre « oui » uniquement le jour de l'ouverture commerciale.
VENTES_REELLES=

# ── Espace administrateur ─────────────────────────────────────────────
# Mot de passe de /admin : 12 caractères minimum, unique, non réutilisé ailleurs.
ADMIN_PASSWORD=
# Chaîne aléatoire de 32 caractères minimum. Signe la session et les autorisations d'envoi de fichiers.
# La changer déconnecte immédiatement toutes les sessions.
SESSION_SECRET=
# Adresse qui reçoit les notifications de commande.
ADMIN_EMAIL=

# ── Stockage ──────────────────────────────────────────────────────────
# Sans les variables S3, tout est rangé dans ce dossier (disque local).
DATA_DIR=./data
# Stockage objet compatible S3 (Cloudflare R2, Scaleway, Backblaze, AWS…). Dès que le bucket
# et les deux clés sont renseignés, le site l'utilise à la place du disque.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Exemple R2 : https://<identifiant-de-compte>.r2.cloudflarestorage.com
S3_ENDPOINT=
# « auto » pour R2 ; sinon la région du fournisseur.
S3_REGION=auto
# « oui » seulement si le fournisseur exige des adresses de type endpoint/bucket/clé.
S3_PATH_STYLE=
# Origine du stockage vue par le navigateur (même valeur que S3_ENDPOINT, sans chemin),
# pour autoriser l'envoi direct des fichiers. À définir avant la compilation.
S3_PUBLIC_ORIGIN=

# ── E-mails ───────────────────────────────────────────────────────────
# Sans clé, les e-mails sont rédigés et archivés dans /admin/courriels, mais pas envoyés.
# Expéditeur, sur un domaine vérifié chez le service. Exemple : Studio Accroche <commandes@mondomaine.fr>
MAIL_FROM=
# Renseigner l'une des deux clés (Brevo est prioritaire si les deux sont présentes).
BREVO_API_KEY=
RESEND_API_KEY=

# ── Mentions légales (obligatoires avant toute vente réelle et toute facture) ──
NEXT_PUBLIC_LEGAL_NAME=
# 14 chiffres.
NEXT_PUBLIC_LEGAL_SIRET=
NEXT_PUBLIC_LEGAL_ADDRESS=
# Adresse de contact dédiée, jamais l'adresse personnelle.
NEXT_PUBLIC_CONTACT_EMAIL=
# Nom et adresse de l'hébergeur du site.
NEXT_PUBLIC_LEGAL_HEBERGEUR=
# Nom et site du médiateur de la consommation choisi.
NEXT_PUBLIC_LEGAL_MEDIATEUR=
