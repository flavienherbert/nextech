# Copie ce fichier en .env et remplis uniquement ce dont tu as besoin. Ne commite JAMAIS .env.

# --- Jalon 1 (dry-run) : rien d'obligatoire ---------------------------------
# Chemins si ffmpeg/ffprobe ne sont pas dans le PATH (ex. C:\ffmpeg\bin\ffmpeg.exe)
#FFMPEG_BIN=ffmpeg
#FFPROBE_BIN=ffprobe
# Police des sous-titres (doit être installée sur Windows)
#SUBTITLE_FONT=Arial
# Taux indicatif USD->EUR pour l'affichage des coûts (les tarifs fournisseurs sont en USD)
#USD_TO_EUR=0.90

# --- Scénario par LLM (optionnel, payant, demande confirmation) --------------
#OPENAI_API_KEY=
#OPENAI_SCRIPT_MODEL=gpt-4.1-mini

# --- Jalons 2 et 3 (pas encore utilisés) -------------------------------------
#FAL_KEY=
#ELEVENLABS_API_KEY=
